# ============================================================================
# Suwasetha Veda Madura (සුවසෙත වෙද මැදුර) - Environment Configuration Example
# Copy this file to .env in production and set your private values.
# NEVER commit a real .env file or PRIVATE_INITIAL_ADMIN_CREDENTIALS.txt to Git.
# ============================================================================

PORT=8080
SUWASETHA_DB_PATH=./suwasetha.db
# Optional: Set an initial password on first installation before running init_db.py.
# If omitted, init_db.py generates a cryptographically strong 18-character random password
# and writes it with 0600 permissions to PRIVATE_INITIAL_ADMIN_CREDENTIALS.txt.
SUWASETHA_INIT_ADMIN_PASSWORD=
SUWASETHA_VERBOSE=0
